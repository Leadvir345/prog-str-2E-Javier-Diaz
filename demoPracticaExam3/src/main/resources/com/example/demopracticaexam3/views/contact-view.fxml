<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox
    maxHeight="-Infinity" maxWidth="-Infinity"
    minHeight="-Infinity" minWidth="-Infinity"
    prefHeight="550.0" prefWidth="650.0"
    spacing="10"
    style="-fx-padding: 20;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.demopracticaexam3.controllers.ContactoController">

    <Label text="Contactos de Emergencia" />

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER"  minWidth="100.0" prefWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"  prefWidth="300.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Label text="Nombre" />
        <TextField fx:id="txtNombre" promptText="Nombre completo"
                   GridPane.columnIndex="1" />

        <Label text="Teléfono" GridPane.rowIndex="1" />
        <TextField fx:id="txtTelefono" promptText="10 dígitos"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Parentesco" GridPane.rowIndex="2" />
        <ComboBox fx:id="cmbParentesco" prefWidth="240"
                  GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <HBox spacing="8">
        <Button text="Agregar"    onAction="#onAdd"      prefWidth="90" />
        <Button text="Buscar"     onAction="#onSearch"   prefWidth="90" />
        <Button text="Actualizar" onAction="#onUpdate"   prefWidth="90" />
        <Button text="Eliminar"   onAction="#onDelete"   prefWidth="90" />
        <Button text="Recargar"   onAction="#onReloaded" prefWidth="90" />
        <Button text="Limpiar"    onAction="#onClear"    prefWidth="90" />
    </HBox>

    <Label fx:id="lblMsg" prefHeight="28" prefWidth="610" text="" />

    <Label text="Contactos registrados" />

    <ListView fx:id="listView" prefHeight="200.0" prefWidth="610.0" />

</VBox>
